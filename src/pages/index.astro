---
import Base from '../layouts/Base.astro';
import PageMediaBlock from '../components/media/PageMediaBlock.astro';
import PortalCards from '../components/home/PortalCards.astro';
import Search from '../components/search/Search.astro';
import Icon from '../components/icons/Icon.astro';
import Facts from '../components/wiki/Facts.astro';
import FAQ from '../components/wiki/FAQ.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import {game,pages,database,categories,categoryURL,entityURL,updates} from '../lib/data';
---
<Base title="Wanderburg" description="Explore the independent Wanderburg field guide: beginner advice, database categories, build advice, and game updates for your next fortress expedition.">
<section class="hero"><div class="hero-copy"><span class="eyebrow">THE WANDERBURG FIELD GUIDE</span><h1>Wanderburg Wiki.<br/><em>Your next move, informed.</em></h1><p>Find practical guides, equipment choices, and the changes that matter to your next run.</p><a class="button" href="/guides/beginner-guide/">Start your expedition <span>→</span></a><div class="hero-meta"><span>PC / STEAM</span><span>·</span><span>INDEPENDENT WIKI</span></div></div><PageMediaBlock page="/" placement="hero"/></section>
<Search/><div class="popular-search"><strong>Popular searches</strong><a href="/guides/beginner-guide/">Getting started</a><a href="/database/modules/">Modules</a><a href="/guides/best-build/">Builds</a><a href="/guides/controls/">Controls</a></div>
<PortalCards/>
<section class="section intro-grid"><div><span class="eyebrow">WELCOME TO THE ROLLING KINGDOM</span><h2>What is Wanderburg?</h2><p>{game.introduction}</p><a class="card-link" href="/wiki/">Open the field notes →</a></div><div><span class="eyebrow">QUICK FACTS</span><Facts/></div></section>
<section class="section start-banner"><span class="icon-box"><Icon name="guide"/></span><div><h2>Start Here: Beginner Guide</h2><p>Learn movement, target selection, module abilities, and the cost of a risky approach. Start with a short movement exercise, then practice using one familiar action without losing your route.</p></div><a class="button" href="/guides/beginner-guide/">Beginner guide →</a></section>
<section class="section"><div class="section-head"><h2>Popular Guides</h2><a href="/guides/">All guides →</a></div><p>Start with survival, then learn how equipment decisions and unlocks change your options. Choose the beginner guide for immediate decisions, builds for combat tradeoffs, or progression for goals between attempts.</p><div class="cards">{[['guide','guides/beginner-guide','01 / GET YOUR BEARINGS'],['builds','guides/best-build','02 / INTO THE WORKSHOP'],['updates','guides/progression','03 / THE NEXT EXPEDITION']].map(([icon,slug,label])=>{const p=pages.find(p=>p.slug===slug)!;return <a class="card" href={'/'+slug+'/'}><div class="card-top"><Icon name={icon}/></div><span class="eyebrow">{label}</span><h3>{p.title.replace('Wanderburg ','')}</h3><p>{p.description}</p><span class="card-link">Read guide →</span></a>})}</div></section>
<section class="section"><div class="section-head"><h2>Explore the database</h2><a href="/database/">Open the archives →</a></div><p>Explore modules, captains, artifacts, vehicles, and biomes. Find an equipment role, learn a character tradeoff, and follow related guides to plan your next build.</p><div class="archive-list">{categories.map(t=><a class="archive-link" href={categoryURL(t)}><Icon name={t}/><span>{t}<small>{database[t].length?database[t].length+' entries':t==='weapons'?'See offensive modules':'Preparation & system notes'}</small></span></a>)}</div></section>
{['modules','captains','bosses','biomes'].map(type=>database[type].length>0&&<section class="section"><h2>{type[0].toUpperCase()+type.slice(1)} field notes</h2><p>{type==='modules'?'Start with documented attacks and utility, then compare how they fit your build. Check automatic behavior and active actions separately: a change to one need not improve the other.':type==='captains'?'Choose a captain around your playstyle and the goal of your run. Consider which drawback affects your usual actions, then consult the full in-game ability before selecting.':'Check the region and difficulty context behind your next encounter. Keep ordinary objectives and overtime separate when comparing what a setup can handle.'}</p><div class="cards">{database[type].slice(0,3).map(e=><a class="card" href={entityURL(type,e.slug)}><h3>{e.name}</h3><p>{e.summary}</p></a>)}</div></section>)}
<section class="section"><div class="section-head"><h2>Builds and comparisons</h2><a href="/tier-list/">Comparison criteria →</a></div><p>Compare captain tradeoffs and module roles before copying a loadout. Find recommendations for beginners, active-ability setups, and contact-oriented combat.</p><div class="content-links"><a href="/guides/best-build/">Build principles →</a><a href="/tier-list/captains/">Captain comparisons →</a><a href="/tier-list/modules/">Module comparisons →</a><a href="/bosses/">Boss preparation →</a></div></section><AdSlot/>
<PageMediaBlock page="/" placement="gallery"/><PageMediaBlock page="/" placement="video"/>
{updates.length>0&&<section class="section"><div class="section-head"><h2>Latest dispatches</h2><a href="/updates/">All updates →</a></div><p>Concise official-update coverage, with version context for the equipment and guides it affects. Use the affected-page links to revisit a particular rule without treating every hotfix as a reason to rebuild your loadout.</p>{updates.slice(0,3).map(u=><a class="dispatch" href={'/updates/#'+u.slug}><time datetime={u.date}>{u.date}</time><div><h3>{u.title}</h3><p>{u.summary}</p></div><span class="tag">{u.version||'Release'}</span></a>)}</section>}
<section class="section"><div class="section-head"><h2>A few things to know</h2><a href="/faq/">All questions →</a></div><FAQ compact/></section>
</Base>
