---
import '../styles/global.css';
import Icon from '../components/icons/Icon.astro';
import {game,pages} from '../lib/data';
interface Props { pageTitle?:string; title:string; description:string; kind?:string; noindex?:boolean; updated?:string; items?:{name:string;url:string}[] }
const {pageTitle,title,description:inputDescription,kind='WebPage',noindex=false,updated=game.updated,items=[]}=Astro.props;
const path=Astro.url.pathname;const origin=Astro.site||new URL('http://localhost:4321');const canonical=new URL(path,origin).href;
const metadata=pages.find(p=>'/'+p.slug+'/'===path);
const description=metadata?.seoDescription||inputDescription;
const seoTitle=pageTitle||metadata?.seoTitle||(title==='Wanderburg'? 'Wanderburg Wiki, Database & Guides | Fortress Portal': title.length<39?title+' | Independent Fortress Field Guide':title+' | Wanderburg');
const crumbs=[{name:'Home',url:'/'},...path.split('/').filter(Boolean).map((x,i,a)=>({name:x.split('-').map(w=>w[0].toUpperCase()+w.slice(1)).join(' '),url:'/'+a.slice(0,i+1).join('/')+'/'}))];
const breadcrumb={'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.url,origin).href}))};
const schema={'@context':'https://schema.org','@graph':path==='/'?[{'@type':'WebSite',name:'Wanderburg Field Guide',url:canonical},{'@type':'Organization',name:'Wanderburg Field Guide',url:canonical},{'@type':'VideoGame',name:game.name,gamePlatform:game.platform,genre:'Roguelike',author:{'@type':'Organization',name:game.developer}},breadcrumb]:[{'@type':kind,name:title,headline:title,description,dateModified:updated,url:canonical,...(kind==='Article'?{author:{'@type':'Organization',name:'Wanderburg Field Guide'}}:{})},breadcrumb,...(kind==='CollectionPage'?[{'@type':'ItemList',itemListElement:items.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,url:new URL(c.url,origin).href}))}]:[])]};
---
<!doctype html><html lang="en"><head><meta name="google-site-verification" content="-ALj3skb_rZge2q9JmtkzmUq7waKTqePG3fwh1acLXo" /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{seoTitle}</title><meta name="description" content={description}/><meta name="robots" content={noindex?'noindex,follow':'index,follow'}/><link rel="canonical" href={canonical}/><meta property="og:title" content={seoTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={kind==='Article'?'article':'website'}/><meta property="og:image" content={new URL('/images/game/portal-cover.png',origin).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={seoTitle}/><meta name="twitter:description" content={description}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body><a class="skip" href="#main">Skip to content</a><header><div class="header-inner"><a class="brand" href="/"><Icon/><span>WANDERBURG<small>THE INDEPENDENT FIELD GUIDE</small></span></a><nav aria-label="Main navigation">{[['/wiki/','Wiki'],['/guides/','Guides'],['/database/','Database'],['/tier-list/','Tier Lists'],['/updates/','Updates']].map(([url,label])=><a href={url} aria-current={path.startsWith(url)?'page':undefined}>{label}</a>)}</nav><a class="header-badge" href="/about/">FAN-MADE <span>✦</span></a></div></header><main id="main" class="container">{path!=='/'&&<nav class="breadcrumbs" aria-label="Breadcrumb">{crumbs.map((c,i)=><>{i>0&&<span>/</span>}<a href={c.url} aria-current={i===crumbs.length-1?'page':undefined}>{c.name}</a></>)}</nav>}<slot/></main><footer><div class="container footer-grid"><div><a class="brand" href="/">WANDERBURG</a><p>Wiki, guides, builds, and update coverage for Wanderburg players.<br/>Not affiliated with Randwerk or Sidekick Publishing.</p><small>Updated <time datetime={updated}>{updated}</time> · Independent fan wiki</small></div><nav aria-label="Footer navigation">{[['/faq/','FAQ'],['/about/','About'],['/contact/','Contact'],['/privacy/','Privacy'],['/terms/','Terms']].map(([url,label])=><a href={url}>{label}</a>)}</nav></div></footer></body></html>
